# Copie para .env (que nao vai para o git) e troque os valores.
# Senha do usuario clinica no PostgreSQL do Compose.
DB_SENHA=troque-esta-senha
# Senha da conta admin, criada na primeira vez que a aplicacao sobe.
CLINICA_SENHA_ADMIN=TroqueEsta123
# Opcional: senha da conta atendente. Vazia = a conta nao e criada.
CLINICA_SENHA_ATENDENTE=
# Opcional: fuso horario da clinica (padrao: Tocantins).
CLINICA_FUSO=America/Araguaina
